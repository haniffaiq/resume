# Single lockfile policy: npm (package-lock.json) is the source of truth.
# CI runs `npm ci`, so a second lockfile would silently diverge.
bun.lockb
bun.lock
yarn.lock
pnpm-lock.yaml

# AI assistant / agent tooling. Local-only: never commit these, so the public
# repo carries no trace of which tools were used.
