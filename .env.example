# EmailJS public browser configuration for src/components/Contact.tsx
# Copy this file to .env.local for local development or configure the same
# variables in your hosting provider / CI environment.
#
# These values are public identifiers, not private API secrets, but still use
# non-production placeholders in examples and never commit real .env files.

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
